#!/usr/bin/env bash
# Format Haskell files with stylish-haskell (uses .stylish-haskell.yaml).
# Usage: bin/format [file ...]  (default: all app sources)
set -euo pipefail

if [ $# -gt 0 ]; then
    exec stylish-haskell -i "$@"
fi

find . -name '*.hs' \
    -not -path './IHP/*' \
    -not -path './build/*' \
    -not -path './.devenv/*' \
    -not -path './.direnv/*' \
    -exec stylish-haskell -i {} +

echo "Formatted all app sources."
