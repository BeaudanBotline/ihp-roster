#!/usr/bin/env bash
# Launch GHCi with the full app loaded — useful for testing expressions.
# Usage: echo 'query @Post |> fetch' | bin/ghci-app
set -euo pipefail

GHC_OPTS=$(make print-ghc-options GHC_RTS_FLAGS='' 2>/dev/null \
  | sed 's/-iIHP[^ ]* //g; s/-fbyte-code//g')

exec ghci $GHC_OPTS Main.hs "$@"
